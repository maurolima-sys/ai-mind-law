# Firebase web app configuration (public client values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=

# Required in production when App Check uses reCAPTCHA Enterprise.
# Local development uses the App Check debug provider instead.
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# App Check debug token for local development only.
# Register this token in Firebase Console > App Check > Apps > Manage debug tokens.
# Never commit the actual value. Never use in production.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Server-side only. Used for optional, separately consented legal research.
FIRECRAWL_API_KEY=

# Server-side only. Used for optional guided-tour narration via ElevenLabs.
# Link the ElevenLabs connector in Lovable, or set this key for local dev.
ELEVENLABS_API_KEY=